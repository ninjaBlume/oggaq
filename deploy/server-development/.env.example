# Sunucudaki ayrı geliştirme kurulumu. Gerçek sırları yalnızca sunucuda 0600 dosyada tutun.
APP_NAME=OGGAQ
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://oggsorubankasi.codentum.net
FRONTEND_URL=https://oggsorubankasi.codentum.net
ADMIN_URL=https://oggsorubankasi.codentum.net/yonetim
APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr
APP_FAKER_LOCALE=tr_TR
LOG_CHANNEL=stderr
LOG_LEVEL=warning
DB_CONNECTION=pgsql
DB_HOST=database
DB_PORT=5432
DB_DATABASE=oggaq
DB_USERNAME=oggaq
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_COOKIE=oggaq_development_session
# Boş domain: oturum yalnızca bu ana makineye aittir, diğer codentum projeleriyle paylaşılmaz.
SESSION_DOMAIN=
SANCTUM_STATEFUL_DOMAINS=oggsorubankasi.codentum.net
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=oggaq_development_
CACHE_PREFIX=oggaq_development_cache
HORIZON_NAME=oggaq-development
HASH_DRIVER=argon2id
ARGON_MEMORY=65536
ARGON_TIME=4
# Geliştirme e-postaları yalnızca Mailpit'e gider. Dışarıya gönderim yapılmaz.
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS=no-reply@oggsorubankasi.codentum.net
MAIL_FROM_NAME=OGGAQ
ERASURE_LEDGER_KEY=
