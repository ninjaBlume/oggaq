# Sunucudaki ayrı geliştirme kurulumu. Gerçek sırları yalnızca sunucuda 0600 dosyada tutun.
APP_NAME="Ogg Sor - Soru Bankası"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://oggsor.com
FRONTEND_URL=https://oggsor.com
ADMIN_URL=https://oggsor.com/yonetim
APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr
APP_FAKER_LOCALE=tr_TR
LOG_CHANNEL=stderr
LOG_LEVEL=warning
DB_CONNECTION=pgsql
DB_HOST=database
DB_PORT=5432
DB_DATABASE=oggaq
DB_USERNAME=oggaq
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_COOKIE=oggaq_development_session
# Boş domain: oturum yalnızca bu ana makineye aittir, diğer codentum projeleriyle paylaşılmaz.
SESSION_DOMAIN=
SANCTUM_STATEFUL_DOMAINS=oggsor.com,www.oggsor.com,oggsorubankasi.codentum.net
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=oggaq_development_
CACHE_PREFIX=oggaq_development_cache
HORIZON_NAME=oggaq-development
HORIZON_PREFIX=oggaq_horizon:
HASH_DRIVER=argon2id
ARGON_MEMORY=65536
ARGON_TIME=4
# Varsayılan Mailpit: dışarıya posta gitmez. Alanın SPF/DKIM doğrulaması tamamlanınca
# özel proje relay'i configure-app-mail.sh --relay ile etkinleştirilir; bk. docs/BRAND.md ve README.
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS=no-reply@oggsor.com
MAIL_FROM_NAME="Ogg Sor - Soru Bankası"
ERASURE_LEDGER_KEY=
