# $HOME/oggaq-development/shared/backup.env  (chmod 600) — configuration of backup.sh / erasures.sh. Contains NO secrets:
# the server holds only the PUBLIC encryption key; the PostgreSQL password is never needed (the scripts talk to the
# database container over its local socket as the `postgres` role).

# Paths on the server (defaults shown). The compose file comes from the current release checkout.
OGGAQ_BASE=$HOME/oggaq-development
# OGGAQ_ENV_FILE=$HOME/oggaq-development/shared/.env
# OGGAQ_POSTGRES_PASSWORD_FILE=$HOME/oggaq-development/shared/.postgres-password
# OGGAQ_COMPOSE_FILE=$HOME/oggaq-development/current/deploy/server-development/compose.yaml

# Only this database is dumped (never oggaq_test, never other projects' databases).
PGDATABASE=oggaq
BACKUP_DIR=$HOME/oggaq-development/backups

# Encryption: age (preferred; `sudo apt install age` on Ubuntu 22.04 if the package is available) or gpg (installed by default).
ENCRYPT_TOOL=gpg
AGE_RECIPIENT_FILE=$HOME/oggaq-development/shared/backup.age.pub
# ENCRYPT_TOOL=gpg: fingerprint of the PUBLIC key imported into this user's keyring (gpg --import oggaq-backup.pub.asc).
GPG_RECIPIENT=

# Retention on the server (daily / weekly / monthly newest backups). The Mac keeps its own, longer history.
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=6

# backup.sh --check fails when the newest backup is older than this (hours); erasures.sh --check likewise.
MAX_AGE_HOURS=26
ERASURES_MAX_AGE_HOURS=6

# Optional failure notification (Slack/Discord/Mattermost-style {"text": "..."}); leave empty to rely on logs + the Mac check.
ALERT_WEBHOOK_URL=
