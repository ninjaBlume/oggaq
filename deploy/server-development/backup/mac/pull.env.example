# ~/.config/oggaq-backup/pull.env  (chmod 600) — configuration of the Mac-side pull script. Contains no secrets.
# Server (placeholder: write the same host you use for SSH, see deploy/server-development/README.md):
SERVER_SSH=harun@SUNUCU_ADRESI
SSH_KEY=$HOME/.ssh/oggaq_dev_ed25519
REMOTE_DIR=/home/harun/oggaq-development/backups
# Local copy (created with mode 0700). Encrypted backups only; the private key must NOT be stored here.
LOCAL_DIR=$HOME/oggaq-backups/server-development
# Warn when the newest database backup / erasure export is older than this many hours.
STALE_HOURS=26
ERASURES_STALE_HOURS=6
# Local retention (independent of the server's 7/4/6): daily / weekly / monthly.
KEEP_DAILY=14
KEEP_WEEKLY=8
KEEP_MONTHLY=12
