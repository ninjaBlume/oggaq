[Unit]
Description=OGGAQ gece yedeği (pg_dump, şifreli)
After=postgresql.service

[Service]
Type=oneshot
User=oggaq-backup
Group=oggaq-backup
EnvironmentFile=/etc/oggaq/backup.env
ExecStart=/srv/oggaq/current/deploy/backup/backup.sh
UMask=0077
Nice=10
IOSchedulingClass=idle
# Başarısızlıkta systemd birimi "failed" olur; backup.sh ayrıca ALERT_WEBHOOK_URL tanımlıysa bildirir.
