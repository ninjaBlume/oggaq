# /etc/oggaq/backup.env (sahibi root, grup oggaq-backup, izin 0640) — yedek betiklerinin yapılandırması.
# Gizli değer içermez: parola PGPASSFILE ile ayrı dosyadadır, şifreleme yalnızca GENEL anahtarı kullanır.

# Salt-okunur yedek rolü (CREATE ROLE oggaq_backup LOGIN; GRANT pg_read_all_data TO oggaq_backup;)
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=oggaq
PGUSER=oggaq_backup
# ~/.pgpass biçiminde tek satır: 127.0.0.1:5432:oggaq:oggaq_backup:PAROLA (izin 0600, sahibi oggaq-backup)
PGPASSFILE=/etc/oggaq/backup.pgpass

BACKUP_DIR=/var/backups/oggaq/db
# `accounts:export-erasures` çıktısı (oggaq-erasures.timer saatlik yazar): silinmiş hesap listesinin yedekten ayrı kopyası.
ERASURES_FILE=/var/backups/oggaq/erasures/erasures-latest.ndjson
# Silme listesi dışa aktarımı bundan eskiyse (saniye) uyarı verilir.
ERASURES_MAX_AGE=10800

# Şifreleme: age (önerilen) ya da gpg. ÖZEL ANAHTAR SUNUCUDA OLMAZ (docs/DEPLOYMENT.md "Anahtar saklama").
ENCRYPT_TOOL=age
AGE_RECIPIENT_FILE=/etc/oggaq/backup.age.pub
# ENCRYPT_TOOL=gpg ise: sunucudaki oggaq-backup anahtarlığına yalnızca GENEL anahtarı içe aktarın.
GPG_RECIPIENT=

# Saklama: gün başına en yeni yedek (KEEP_DAILY gün), hafta başına en yeni (KEEP_WEEKLY hafta), ay başına en yeni (KEEP_MONTHLY ay).
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=6

# Sunucu dışı kopya (hedefi kullanıcı seçer): none | rclone | rsync
OFFSITE_MODE=none
# rclone: önceden `rclone config` ile tanımlı uzak ve yol, örn. yedek-uzak:oggaq-yedekleri
RCLONE_REMOTE=
# rsync (ssh anahtarlı): kullanici@sunucu:/yol/
RSYNC_TARGET=

# Başarısızlıkta POST edilecek adres (isteğe bağlı; Slack/Discord/Mattermost "text" gövdesi). Boş bırakılabilir.
ALERT_WEBHOOK_URL=
# --check: son başarılı yedek bundan eskiyse (saat) hata ile çıkar (izleme için).
MAX_AGE_HOURS=26
