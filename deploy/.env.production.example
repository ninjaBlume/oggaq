# OGGAQ üretim ortamı örneği. Gerçek değerler SUNUCUDA /srv/oggaq/shared/.env dosyasında (izin 0600, sahibi oggaq)
# tutulur; bu dosya sürüm kontrolünde yalnızca yapıdır. Hiçbir gizli değeri buraya yazmayın.
# Adresler yer tutucudur: app/admin/api alt alan adlarının üçü de AYNI kayıtlı alan adının altında olmalıdır
# (aksi halde oturum çerezi gönderilmez, docs/DEPLOYMENT.md "Çerezler ve CORS").

APP_NAME=OGGAQ
APP_ENV=production
# php artisan key:generate --show çıktısı; kaybolursa şifreli oturumlar ve kuyruk yükleri okunamaz.
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com
APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr
APP_FAKER_LOCALE=tr_TR

# Tarayıcı kaynakları: CORS izinleri ve oturum açma sonrası yönlendirmeler bunlardan gelir (sonda / olmadan).
FRONTEND_URL=https://app.example.com
ADMIN_URL=https://admin.example.com

# Günlükler: parola, token veya kişisel veri yazılmaz (uygulama böyle yazmaz); 14 gün döner.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning

# PostgreSQL 18, aynı makinede. Uygulama rolü superuser/createdb yetkisiz olmalıdır (docs/DEPLOYMENT.md).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=oggaq
DB_USERNAME=oggaq
DB_PASSWORD=
# Veritabanı başka makinedeyse verify-full ve CA sertifikası kullanın; aynı makinede prefer yeterlidir.
DB_SSLMODE=prefer

# Oturum: çerez yalnızca HTTPS ile gider, içerik şifreli. SESSION_DOMAIN üç alt alan adının ortak kökü (başında nokta).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=.example.com
# İsteği API'ye gönderen tarayıcı kaynaklarının ana makine adları (protokolsüz, virgülle).
SANCTUM_STATEFUL_DOMAINS=app.example.com,admin.example.com
MOBILE_TOKEN_MINUTES=10080

# Redis: önbellek ve kuyruk. Yalnızca 127.0.0.1'e bağlanır; parola yine de tanımlanır.
CACHE_STORE=redis
CACHE_PREFIX=oggaq_cache
QUEUE_CONNECTION=redis
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=oggaq_database_
HORIZON_NAME=oggaq-production

# Parola özetleme: üretim değerleri (testlerdeki düşük maliyet ayarı üretimde kullanılmaz).
HASH_DRIVER=argon2id
ARGON_MEMORY=65536
ARGON_TIME=4

# E-posta: sağlayıcınızın SMTP bilgileri. Hesap doğrulama, parola sıfırlama ve e-posta değişikliği buradan gider.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_SCHEME=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=OGGAQ

# Silinen hesap listesinin (docs/PRIVACY.md) gizli anahtarı. Zorunlu. openssl rand -hex 32 ile üretin.
# Veritabanı yedeğiyle AYNI yerde saklamayın (yedekten ayrı, parola yöneticisinde bir kopya); kaybolursa
# geri yüklemeden sonra silinmiş hesaplar tanınamaz, değişirse eski kayıtlar eşleşmez.
ERASURE_LEDGER_KEY=
