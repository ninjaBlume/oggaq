# BU DOSYA ÖRNEKTİR. Gerçek dosyayı deploy/nginx/update-cloudflare-ips.sh sunucuda üretir
# (/etc/nginx/snippets/cloudflare-realip.conf): Cloudflare'in yayımladığı adres aralıkları ve CF-Connecting-IP.
# Cloudflare kullanmıyorsanız (Let's Encrypt, doğrudan erişim) bu dosyayı HİÇ dahil etmeyin: aksi halde herkes
# CF-Connecting-IP başlığıyla kendi adresini sahte gösterebilir ve hız sınırları aşılır.
# set_real_ip_from 203.0.113.0/24;   # <- betik gerçek aralıkları yazar
real_ip_header CF-Connecting-IP;
real_ip_recursive on;
