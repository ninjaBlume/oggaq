    "/api/v1/auth/verify-email/{id}/{hash}": {
      "get": {
        "operationId": "verifyEmail",
        "summary": "İmzalı bağlantıyla e-posta doğrulama",
        "description": "Giriş yapmış aynı kullanıcı, geçerli signature ve expires gerektirir.",
