{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://oggsor.com",
        "EXPO_PUBLIC_WEB_URL": "https://oggsor.com"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://oggsor.com",
        "EXPO_PUBLIC_WEB_URL": "https://oggsor.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_LOCAL_PREVIEW": "0",
        "EXPO_PUBLIC_API_URL": "https://oggsor.com",
        "EXPO_PUBLIC_WEB_URL": "https://oggsor.com"
      },
      "distribution": "store",
      "node": "24.22.0",
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "play-internal": {
      "extends": "production",
      "channel": "android-beta",
      "environment": "preview",
      "distribution": "store",
      "android": {
        "buildType": "app-bundle"
      },
      "node": "24.22.0"
    },
    "testflight": {
      "extends": "production",
      "channel": "testflight",
      "environment": "preview",
      "distribution": "store",
      "ios": {
        "simulator": false
      },
      "node": "24.22.0"
    }
  },
  "submit": {
    "production": {},
    "testflight": {
      "ios": {
        "ascAppId": "6827324899",
        "appleTeamId": "CHS5258JRU"
      }
    }
  }
}
